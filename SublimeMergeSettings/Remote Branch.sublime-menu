[
	{
		"caption": "Open Pull Request of $branch",
		"command": "git",
		"args": { "argv": ["open", "open_pr", "$branch"] }
	},
	// {
	// 	"caption": "Open Pull Request of $branch on Feature branch",
	// 	"command": "git",
	// 	"args": { "argv": ["open", "open_pr", "$branch", "origin/feat"] }
	// },
	{
		"caption": "Copy Review Request of $branch",
		"command": "git",
		"args": { "argv": ["open", "review_pr", "$branch"] }
	},
	{
		"caption": "in GitHub for $branch",
		"children": [
			{
				"caption": "Open Branch $branch",
				"command": "git",
				"args": { "argv": ["open", "branch", "$branch"] }
			},
			{
				"caption": "Create Pull Request of $branch",
				"command": "git",
				"args": { "argv": ["open", "pr", "$branch"] }
			},
			{
				"caption": "View Pull Requests of $branch",
				"command": "git",
				"args": { "argv": ["open", "view_prs", "$branch"] }
			}
		]
	}
]
